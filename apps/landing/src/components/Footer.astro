---
import { site, footerNav } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const cols = [
  { title: 'Menu', links: footerNav.menu },
  { title: 'Jurisdictions', links: footerNav.jurisdictions },
  { title: 'Contact', links: footerNav.contact },
];
---
<footer class="site-footer container section">
  <div class="panel on-brand">
    <div class="top">
      <div class="follow">
        <h2 class="heading">{site.infrastructure.label}</h2>
        <p class="infra">{site.infrastructure.name}</p>
      </div>
      <nav class="cols" aria-label="Footer" data-stagger data-each=".1">
        {cols.map((c) => (
          <div class="col">
            <h2 class="heading">{c.title}</h2>
            <ul role="list">{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <address class="meta">
      <span>© {year} {site.name}</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </address>
    <div class="wordmark" aria-hidden="true"><Logo class="wordmark__logo" data-rise /></div>
  </div>
</footer>
<style>
  .panel { background: var(--brand); container-type: inline-size; overflow: hidden; padding: clamp(32px, 4.5vw, 56px) clamp(16px, 2.8vw, 32px) 0; padding: round(clamp(32px, 4.5vw, 56px), 8px) round(clamp(16px, 2.8vw, 32px), 8px) 0; }
  .top { display: grid; gap: 40px; }
  .heading { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-body); line-height: 1.4; }
  .follow { display: grid; align-content: start; }
  .infra { margin-top: 16px; font-family: var(--font-display); font-size: var(--fs-h4); line-height: 1.2; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 32px; }
  .col ul { margin-top: 16px; display: grid; gap: 8px; }
  .col a { color: var(--on-brand-muted); font-size: 0.906rem; display: inline-flex; gap: 12px; align-items: center; padding: 2px 0; }
  .col a::before { content: ''; width: 3px; height: 3px; background: currentColor; border-radius: 50%; }
  .col a { transition: color .3s, transform .45s cubic-bezier(.16,1,.3,1); }
  .col a:hover { color: var(--white); transform: translateX(6px); }
  .meta { font-style: normal; margin-top: 48px; display: flex; flex-wrap: wrap; gap: 8px 32px; font-size: var(--fs-xs); color: var(--on-brand-muted); }
  .meta a:hover { color: var(--white); }
  .wordmark { margin-top: calc(clamp(32px, 4vw, 56px) + 32px); margin-top: calc(round(clamp(32px, 4vw, 56px), 8px) + 32px); overflow: hidden; user-select: none; }
  /* the logo fills the panel width and sinks slightly below the edge (clipped), like a ghost wordmark */
  .wordmark :global(.wordmark__logo) { width: 100%; height: auto; max-height: none; margin-bottom: -2.5%; }
  @media (min-width: 900px) {
    .top { grid-template-columns: minmax(0, 1.55fr) minmax(0, 2.45fr); min-height: 250px; }
    .cols { grid-template-columns: 1fr 1.35fr 0.9fr; }
  }
  @media (max-width: 600px) { .panel { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
