---
import { nav, site } from '../data/site';
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <nav class="nav container" aria-label="Primary">
    <a class="nav__logo" href="/" aria-label={`${site.name} home`}><Logo height={34} /></a>
    <ul class="nav__list" role="list">
      {nav.links.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
    </ul>
    <div class="nav__cta"><Button href={nav.cta.href} variant="solid">{nav.cta.label}</Button></div>
    <details class="nav__mobile">
      <summary><span class="visually-hidden">Open menu</span><span class="burger" aria-hidden="true"><i></i><i></i></span></summary>
      <ul role="list">
        {nav.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><Button href={nav.cta.href} variant="solid" full>{nav.cta.label}</Button></li>
      </ul>
    </details>
  </nav>
</header>

<script>
  // Scroll-spy (home page): the nav link for the section under the reading line (just below the sticky bar) gets
  // aria-current="location", so it stays highlighted as you scroll. Sections without their own link keep the last one.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header && location.pathname === '/') {
    const MAP: [string, string | null][] = [
      ['.hero', null], ['#process', '/#process'], ['#join', '/#join'], ['#method', '/#join'], ['#log', '/#join'], ['#faq', '/#faq'], ['#report', null],
    ];
    const sections = MAP.map(([sel, href]) => ({ el: document.querySelector<HTMLElement>(sel), href })).filter((s) => s.el);
    const links = Array.from(header.querySelectorAll<HTMLAnchorElement>('.nav__list a'));
    let current: string | null = '';
    const apply = (href: string | null) => {
      if (href === current) return;
      current = href;
      for (const a of links) {
        const on = a.getAttribute('href') === href;
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    const update = () => {
      const top = header.getBoundingClientRect().bottom;
      const line = top + (innerHeight - top) * 0.3;
      let href: string | null = null;
      for (const s of sections) if (s.el!.getBoundingClientRect().top <= line) href = s.href;
      apply(href);
    };
    let raf = 0;
    const schedule = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    addEventListener('load', update);
    update();
  }
</script>

<style>
  /* plain white bar: logo left, links centred, one call-to-action on the right */
  .site-header { position: sticky; top: 0; z-index: 60; background: var(--white); box-shadow: 0 1px 0 var(--line-soft); color: var(--brand); }
  .nav { position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 76px; }
  .nav__logo { display: block; padding: 12px 0; }
  .nav__logo :global(.logo) { transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .nav__logo:hover :global(.logo) { transform: scale(1.04); }
  .nav__list { display: none; gap: 8px; font-size: var(--fs-body); }
  .nav__list a { display: inline-flex; padding: 12px 16px; color: var(--brand); transition: color .3s; }
  .nav__list a:hover, .nav__list a.is-active { color: var(--brand-ink); }
  .nav__list a.is-active { font-weight: 700; }
  .nav__cta { display: none; }
  .nav__mobile summary { list-style: none; cursor: pointer; padding: 16px 4px; }
  .nav__mobile summary::-webkit-details-marker { display: none; }
  .burger { display: grid; gap: 8px; width: 22px; }
  .burger i { display: block; height: 1.5px; background: currentColor; transition: transform .2s; }
  .nav__mobile[open] .burger i:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav__mobile[open] .burger i:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .nav__mobile ul { position: absolute; z-index: 20; left: 0; right: 0; top: 100%; background: var(--white); box-shadow: 0 18px 40px -24px rgb(8 17 31 / .35); padding: 8px var(--gutter) 24px; display: grid; }
  .nav__mobile li a:not(.btn) { display: block; padding: 14px 0; border-top: 1px solid var(--line-soft); }
  .nav__mobile li:last-child { padding-top: 16px; }
  @media (min-width: 900px) {
    .nav { display: grid; grid-template-columns: 1fr auto 1fr; }
    .nav__list { display: flex; }
    .nav__cta { display: flex; justify-content: end; }
    .nav__mobile { display: none; }
  }
</style>
