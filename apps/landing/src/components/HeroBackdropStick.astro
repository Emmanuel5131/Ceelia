---
import HeroCaption from './HeroCaption.astro';
import HeroFigure from './HeroFigure.astro';
import HeroTag from './HeroTag.astro';
/**
 * Hero backdrop, stick-figure version: the whole story in five frames, then rested, faded and replayed. Each frame is its own
 * picture: it fades in, and is gone before the next one fades in. A single caption names the step that is playing; name tags say
 * who each actor is, and the speech bubbles and "!" marks carry the rest.
 *   frame 1  1  a hooded operator promises 10% a week      2  victims pay in, then are asked for a fee to withdraw
 *   frame 2  3  the money moves out through a mixer and is cashed out at an exchange
 *   frame 3  4  Celia's case bank holds the wallets of those defrauded      5  and the evidence next to them
 *   frame 4  6  Celia connects the case bank to lawyers and law firms          7  they start with wallets and evidence listed
 *   frame 5  8  a lawyer or firm runs the case in court      9  together, victims hold the platform accountable
 * Words name actions, never people or intent. Seal red is for the seal and the verdict only. The story is an illustration, and
 * says so. A small script restarts the animation (class `on` on the svg) after a pause and fades it out between runs; CSS does
 * the rest: every element animates in with its own delay (--d) and duration (--dur), measured from the start of the run.
 * Elements rest in their finished state (only the last frame shows), so the reduced-motion and no-script views are never half
 * drawn. The viewBox is 1600 × 960.
 */
type P = [number, number];
const d = (pts: P[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join('');
const sty = (dl: number, dur?: number) => `--d:${dl.toFixed(2)}s${dur ? `;--dur:${dur}s` : ''}`;
const ride = (dl: number, dur: number, path: P[]) => `${sty(dl, dur)};offset-path:path('${d(path)}')`;

const dots: P[] = [];
for (let y = 0; y < 12; y++) for (let x = 0; x < 20; x++) dots.push([x * 80 + 40, y * 80 + 40]);

const LINE = 500;
const SHRINK = 1, PIVOT: P = [1560, 520]; // the whole story is drawn at full size, then scaled down about the right edge to leave room for the copy
const FADE = 0.3;
const SLOW = 3.6; // everything below is written in seconds of the base story; the svg stretches it by this factor
const LENGTHS = [3.8, 2.0, 3.4, 3.4, 6.4];
const TOTAL = LENGTHS.reduce((sum, n) => sum + n, 0);
const STARTS = LENGTHS.map((_, i) => LENGTHS.slice(0, i).reduce((sum, n) => sum + n, 0));
/** Seconds from the start of the run to `offset` seconds into `frame`. */
const t = (frame: number, offset = 0) => STARTS[frame] + offset;
const frameStyle = (frame: number) => `--fdl:${STARTS[frame].toFixed(2)}s;--fout:${(STARTS[frame] + LENGTHS[frame] - FADE).toFixed(2)}s`;

const captions: [string, number, number][] = [
  ['1 · A new app promises 10% a week', t(0), 1.8],
  ['2 · Victims pay in, then are asked for a fee to withdraw', t(0, 1.8), 2],
  ['3 · The money’s trail is hidden, then it is cashed out', t(1), 2],
  ['4 · Celia’s case bank holds the wallets of those defrauded', t(2), 1.7],
  ['5 · And the evidence next to them: the sealed chain proofs', t(2, 1.7), 1.7],
  ['6 · Celia connects the case bank to lawyers and law firms', t(3), 1.7],
  ['7 · They start with the wallets and evidence already listed', t(3, 1.7), 1.7],
  ['8 · A lawyer or firm runs the case in court', t(4), 1.9],
  ['9 · Case won: victims hold the platform accountable', t(4, 1.9), 1.9],
  ['10 · The lawyer pays the listed wallets, or contacts victims', t(4, 3.8), 2.4],
];

/** The nearest dot of the background grid: every figure's head is centred on a dot. */
const snap = (n: number) => Math.round((n - 40) / 80) * 80 + 40;
const victimsAt = (x: number): P[] => [360, 520, 680].map((y): P => [snap(x), y]);
const hand = (v: P): P => [v[0] + 20, v[1] + 42];
/** A bank: a triangle roof, a beam, four columns and two steps, centred on `x`. */
const bankBuilding = (x: number, cy = LINE) => ({ roof: `M${x - 66} ${cy - 22}L${x} ${cy - 72}L${x + 66} ${cy - 22}Z`, beam: { x: x - 66, y: cy - 22, w: 132, h: 9 }, cols: [-46, -16, 16, 46].map((dx) => ({ x: x + dx - 6, y: cy - 13, w: 12, h: 46 })), steps: [{ x: x - 74, y: cy + 33, w: 148, h: 9 }, { x: x - 82, y: cy + 42, w: 164, h: 9 }] });
/** Scales of justice, drawn inside a roof: a post, a beam and two pans. */
const scales = (x: number, cy: number) => `M${x} ${cy - 56}V${cy - 32}M${x - 18} ${cy - 46}H${x + 18}M${x - 18} ${cy - 46}L${x - 23} ${cy - 37}M${x - 18} ${cy - 46}L${x - 13} ${cy - 37}M${x - 26} ${cy - 37}Q${x - 18} ${cy - 30} ${x - 10} ${cy - 37}M${x + 18} ${cy - 46}L${x + 13} ${cy - 37}M${x + 18} ${cy - 46}L${x + 23} ${cy - 37}M${x + 10} ${cy - 37}Q${x + 18} ${cy - 30} ${x + 26} ${cy - 37}`;

// frame 1: the promise, the deposits, the gate
const victims = victimsAt(860);
const operator: P = [snap(1120), snap(300)];
const gateX = 985;
const app: P = [operator[0], LINE];

// frame 2: the same app and operator, now on the left, with the mixer and the exchange across the stage
const operator2: P = [snap(940), snap(300)];
const app2: P = [operator2[0], LINE];
const mixer: P = [1220, LINE];
const exchange: P = [1500, LINE];
const strands: P[][] = [[mixer, [1360, 430], exchange], [mixer, exchange], [mixer, [1360, 570], exchange]];

// frame 3: Celia's case bank, with the victims who joined, the possible ones, and the proofs
const claimants = victimsAt(880);
const bank = { x: 1080, y: 300, w: 460, h: 310 };
const rows: [string, boolean][] = [['0x7a3f…e91c', true], ['0x19cd…04b2', true], ['0xb6e0…7f35', true], ['0x52a8…c1d9', false], ['0x93de…5a07', false]];
const rowY = (i: number) => 372 + i * 46;
const proofs = ['funding trail', 'cohort vs baseline', 'sealed hash', 'certificate'];
const celia: P = [snap(1310), snap(664)];

// frame 4: the case bank connected to lawyers and law firms
const hub = { x: 840, y: 400, w: 190, h: 200 };
const targets: [number, string, 'lawyer' | 'firm'][] = [[320, 'lawyer', 'lawyer'], [520, 'law firm', 'firm'], [700, 'lawyer', 'lawyer']];
const TX = snap(1360);

// frame 5: a lawyer runs the case, and more victims join
const UP = 160; // the last frame sits two dot rows higher, closer to its caption
const lawyer5: P = [snap(1080), snap(420) - UP];
const judge: P = [snap(1465), snap(410) - UP];
const bench = { x: judge[0] - 85, y: 470 - UP, w: 170, h: 76 };
const crowd: P[] = [0, 1, 2, 3, 4, 5, 6].map((i): P => [snap(840 + i * 80), snap(690) - UP]);
---
<svg class="bd" viewBox="0 0 1600 960" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false" style={`--slow:${SLOW}`} data-cycle={Math.round((TOTAL * SLOW + 3) * 1000)}>
  <!-- the dot grid, always on, under the story so it never runs through a tag -->
  <g class="bd__dots">
    {dots.map(([x, y]) => <circle class="bd__dot" cx={x} cy={y} r="2.8" />)}
  </g>
  <g class="bd__scenes">
    <g transform={`translate(${PIVOT[0]} ${PIVOT[1]}) scale(${SHRINK}) translate(${-PIVOT[0]} ${-PIVOT[1]})`}>
    {captions.map(([text, delay, dur], i) => <HeroCaption text={text} x={820} y={196} delay={delay} dur={dur || undefined} last={i === captions.length - 1} />)}
    <HeroTag text="illustrative example" x={1560} y={846} delay={0.3} anchor="end" />

    <!-- frame 1: the promise, the deposits, the gate -->
    <g class="bd__frame" style={frameStyle(0)}>
      <HeroFigure kind="operator" x={operator[0]} y={operator[1]} delay={t(0)} dur={0.7} />
      <HeroTag text="scammer" x={operator[0]} y={410} delay={t(0, 0.8)} anchor="mid" />
      <g class="bd__fade" style={sty(t(0, 0.1), 0.5)}>
        <rect class="bd__box" x={app[0] - 50} y={LINE - 38} width="100" height="76" rx="6" />
        <text class="bd__glyph" x={app[0]} y={LINE + 7}>+10%</text>
      </g>
      <HeroTag text="scam crypto app" x={app[0]} y={LINE + 74} delay={t(0, 0.4)} anchor="mid" />
      <g transform={`translate(${operator[0] - 1120} ${operator[1] - 300})`}>
        <g class="bd__tmp" style={sty(t(0, 0.3), 1.7)}>
          <rect class="bd__box" x="1170" y="236" width="190" height="52" rx="10" />
          <path class="bd__box bd__tail" d="M1186 288L1146 318L1214 288Z" />
          <text class="bd__say" x="1186" y="270">10% a week!</text>
        </g>
      </g>

      {victims.map((v, i) => (
        <g class="bd__fig" style={sty(t(0, 1.6 + i * 0.1), 0.6)} transform={`translate(${v[0]} ${v[1]}) scale(1.05)`}>
          <circle class="bd__draw bd__head" r="11" pathLength="1" />
          <path class="bd__draw" d="M0 11V44M-14 68L0 44L14 68" pathLength="1" />
          <path class="bd__draw bd__arms-down" style={`--dur:${(t(0, 3.0) - t(0, 1.6 + i * 0.1)).toFixed(2)}s`} d="M-17 38L0 25L17 38" pathLength="1" />
          <path class="bd__arms-up" style={`--d:${t(0, 3.0 + i * 0.05).toFixed(2)}s`} d="M-17 8L0 25L17 8" />
          <text class="bd__bang" style={sty(t(0, 3.1 + i * 0.05), 0.3)} x="32" y="2">!</text>
        </g>
      ))}
      <HeroTag text="victims" x={victims[1][0]} y={victims[2][1] + 118} delay={t(0, 1.9)} anchor="mid" />
      {victims.map((v, i) => <path class="bd__edge bd__edge--thin" style={sty(t(0, 1.8 + i * 0.1), 0.4)} d={d([hand(v), [app[0] - 50, LINE]])} pathLength="1" />)}
      {victims.map((v, i) => <path class="bd__comet" style={sty(t(0, 1.9 + i * 0.12), 0.8)} d={d([hand(v), [app[0] - 50, LINE]])} pathLength="1" />)}
      <circle class="bd__pulse" style={sty(t(0, 2.6), 0.9)} cx={app[0]} cy={app[1]} r="70" />
      <circle class="bd__pulse" style={sty(t(0, 2.8), 0.9)} cx={app[0]} cy={app[1]} r="70" />

      <path class="bd__edge bd__edge--thick" style={sty(t(0, 2.9), 0.35)} d={d([[gateX, 340], [gateX, 720]])} pathLength="1" />
      <g class="bd__fade" style={sty(t(0, 3.2), 0.4)}>
        <circle class="bd__box" cx={gateX} cy={LINE} r="30" />
        <path class="bd__shackle" d={`M${gateX - 10} ${LINE - 2}V${LINE - 11}a10 10 0 0 1 20 0V${LINE - 2}`} />
        <rect class="bd__lock" x={gateX - 15} y={LINE - 3} width="30" height="23" rx="3" />
      </g>
      <path class="bd__comet bd__comet--stop" style={sty(t(0, 3.0), 0.4)} d={d([[app[0] - 50, LINE], [gateX + 6, LINE]])} pathLength="1" />
      <g transform={`translate(${operator[0] - 1120} ${operator[1] - 300})`}>
        <g class="bd__tmp" style={sty(t(0, 3.0), 0.7)}>
          <rect class="bd__box" x="1170" y="236" width="290" height="52" rx="10" />
          <path class="bd__box bd__tail" d="M1186 288L1146 318L1214 288Z" />
          <text class="bd__say" x="1186" y="270">pay a fee to withdraw</text>
        </g>
      </g>
    </g>

    <!-- frame 2: the money moves out and is cashed out -->
    <g class="bd__frame" style={frameStyle(1)}>
      <g class="bd__vanish" style={sty(t(1, 0.3))}>
        <HeroFigure kind="operator" x={operator2[0]} y={operator2[1]} delay={t(1)} dur={0.3} />
      </g>
      <g class="bd__fade" style={sty(t(1), 0.3)}>
        <rect class="bd__box" x={app2[0] - 50} y={LINE - 38} width="100" height="76" rx="6" />
        <text class="bd__glyph" x={app2[0]} y={LINE + 7}>+10%</text>
      </g>
      <HeroTag text="scam crypto app" x={app2[0]} y={LINE + 74} delay={t(1, 0.1)} anchor="mid" />
      <path class="bd__edge bd__edge--thick" style={sty(t(1, 0.1), 0.5)} d={d([[app2[0] + 50, LINE], mixer])} pathLength="1" />
      <g class="bd__fade" style={sty(t(1, 0.3), 0.3)}>
        <circle class="bd__box" cx={mixer[0]} cy={mixer[1]} r="54" />
        <circle class="bd__spin" cx={mixer[0]} cy={mixer[1]} r="32" />
        <text class="bd__q" x={mixer[0]} y={mixer[1] + 13}>?</text>
      </g>
      <HeroTag text="hides the trail" x={mixer[0]} y={mixer[1] + 96} delay={t(1, 0.5)} anchor="mid" />
      <g class="bd__packet bd__coin" style={ride(t(1, 0.2), 0.7, [[app2[0] + 50, LINE], mixer])}><circle r="14" /><text y="5">$</text></g>

      {strands.map((s, i) => <path class="bd__edge" style={sty(t(1, 0.8 + i * 0.05), 0.5)} d={d(s)} pathLength="1" />)}
      <g class="bd__fade" style={sty(t(1, 0.9), 0.3)}>
        <path class="bd__box" d={bankBuilding(exchange[0]).roof} />
        <rect class="bd__box" x={bankBuilding(exchange[0]).beam.x} y={bankBuilding(exchange[0]).beam.y} width={bankBuilding(exchange[0]).beam.w} height={bankBuilding(exchange[0]).beam.h} />
        {bankBuilding(exchange[0]).cols.map((c) => <rect class="bd__box" x={c.x} y={c.y} width={c.w} height={c.h} />)}
        {bankBuilding(exchange[0]).steps.map((c) => <rect class="bd__box" x={c.x} y={c.y} width={c.w} height={c.h} />)}
        <text class="bd__glyph" x={exchange[0]} y={LINE - 30}>$</text>
      </g>
      <HeroTag text="exchange · cash out" x={exchange[0]} y={exchange[1] + 96} delay={t(1, 1.1)} anchor="mid" />
      <g class="bd__packet bd__coin" style={ride(t(1, 1.0), 0.7, [mixer, exchange])}><circle r="14" /><text y="5">$</text></g>
      <circle class="bd__pulse" style={sty(t(1, 1.5), 0.6)} cx={exchange[0]} cy={exchange[1] + 12} r="80" />
    </g>

    <!-- frame 3: Celia's case bank -->
    <g class="bd__frame" style={frameStyle(2)}>
      {claimants.map((v, i) => <HeroFigure kind="victim" x={v[0]} y={v[1]} delay={t(2, i * 0.1)} dur={0.5} />)}
      <HeroTag text="victims" x={claimants[1][0]} y={claimants[2][1] + 118} delay={t(2, 0.4)} anchor="mid" />
      <rect class="bd__box" style={sty(t(2, 0.2), 0.4)} x={bank.x} y={bank.y} width={bank.w} height={bank.h} />
      <HeroTag text="Celia · case bank" x={bank.x + bank.w / 2} y={bank.y - 10} delay={t(2, 0.5)} anchor="mid" />
      <path class="bd__edge bd__edge--thin" style={sty(t(2, 0.5), 0.4)} d={d([[bank.x + 230, bank.y + 30], [bank.x + 230, bank.y + bank.h - 20]])} pathLength="1" />
      <text class="bd__hdr" style={sty(t(2, 0.6), 0.4)} x={bank.x + 20} y={bank.y + 34}>wallets of the defrauded</text>
      <text class="bd__hdr" style={sty(t(2, 1.9), 0.4)} x={bank.x + 250} y={bank.y + 34}>evidence</text>
      {claimants.map((v, i) => <path class="bd__edge bd__edge--thin" style={sty(t(2, 0.6 + i * 0.1), 0.4)} d={d([hand(v), [bank.x, rowY(i)]])} pathLength="1" />)}
      {claimants.map((v, i) => <path class="bd__comet" style={sty(t(2, 0.8 + i * 0.15), 0.7)} d={d([hand(v), [bank.x, rowY(i)]])} pathLength="1" />)}
      {rows.map(([label, joined], i) => (
        <g class="bd__fade" style={sty(joined ? t(2, 1.3 + i * 0.15) : t(2, 1.7 + (i - 3) * 0.15), 0.4)}>
          <rect class={joined ? 'bd__tick' : 'bd__tick bd__tick--none'} x={bank.x + 20} y={rowY(i) - 9} width="18" height="18" />
          {joined && <path class="bd__tickmark" d={`M${bank.x + 24} ${rowY(i)}l3.2 3.6 6-7`} />}
          <text class="bd__rowtxt" x={bank.x + 48} y={rowY(i) + 5}>{label}</text>
        </g>
      ))}
      {proofs.map((label, i) => (
        <g class="bd__fade" style={sty(t(2, 2.1 + i * 0.28), 0.4)}>
          <rect class="bd__tick" x={bank.x + 250} y={rowY(i) - 9} width="18" height="18" />
          <path class="bd__tickmark" d={`M${bank.x + 254} ${rowY(i)}l3.2 3.6 6-7`} />
          <text class="bd__rowtxt" x={bank.x + 278} y={rowY(i) + 5}>{label}</text>
        </g>
      ))}
      <HeroFigure kind="celia" x={celia[0]} y={celia[1]} delay={t(2, 0.4)} dur={0.6} />
      <HeroTag text="Celia" x={celia[0]} y={celia[1] + 118} delay={t(2, 0.9)} anchor="mid" />
    </g>

    <!-- frame 4: the case bank is connected to lawyers and law firms -->
    <g class="bd__frame" style={frameStyle(3)}>
      <rect class="bd__box" style={sty(t(3, 0.1), 0.4)} x={hub.x} y={hub.y} width={hub.w} height={hub.h} />
      <HeroTag text="Celia · case bank" x={hub.x + hub.w / 2} y={hub.y - 10} delay={t(3, 0.3)} anchor="mid" />
      {['wallets', 'evidence'].map((label, i) => (
        <g class="bd__fade" style={sty(t(3, 0.4 + i * 0.2), 0.4)}>
          <rect class="bd__tick" x={hub.x + 22} y={hub.y + 56 + i * 56 - 9} width="18" height="18" />
          <path class="bd__tickmark" d={`M${hub.x + 26} ${hub.y + 56 + i * 56}l3.2 3.6 6-7`} />
          <text class="bd__rowtxt" x={hub.x + 52} y={hub.y + 56 + i * 56 + 5}>{label}</text>
        </g>
      ))}
      {targets.map(([y, , kind], i) => (
        kind === 'lawyer'
          ? <HeroFigure kind="lawyer" x={TX} y={snap(y - 20)} delay={t(3, 0.5 + i * 0.2)} dur={0.5} scale={0.85} />
          : (
            <g class="bd__fade" style={sty(t(3, 0.5 + i * 0.2), 0.4)}>
              <path class="bd__box" d={bankBuilding(TX, y).roof} />
              <rect class="bd__box" x={bankBuilding(TX, y).beam.x} y={bankBuilding(TX, y).beam.y} width={bankBuilding(TX, y).beam.w} height={bankBuilding(TX, y).beam.h} />
              {bankBuilding(TX, y).cols.map((c) => <rect class="bd__box" x={c.x} y={c.y} width={c.w} height={c.h} />)}
              {bankBuilding(TX, y).steps.map((c) => <rect class="bd__box" x={c.x} y={c.y} width={c.w} height={c.h} />)}
              <path class="bd__scales" d={scales(TX, y)} />
            </g>
          )
      ))}
      {targets.map(([y, label], i) => <HeroTag text={label} x={TX} y={y + (label === 'law firm' ? 66 : 72)} delay={t(3, 0.7 + i * 0.2)} anchor="mid" />)}
      {targets.map(([y], i) => <path class="bd__edge bd__edge--thin" style={sty(t(3, 0.9 + i * 0.15), 0.5)} d={d([[hub.x + hub.w, hub.y + hub.h / 2], [TX - 80, y]])} pathLength="1" />)}
      {targets.map(([y], i) => <path class="bd__comet" style={sty(t(3, 1.1 + i * 0.2), 0.8)} d={d([[hub.x + hub.w, hub.y + hub.h / 2], [TX - 80, y]])} pathLength="1" />)}
      {targets.map(([y], i) => (
        <g class="bd__mark" style={sty(t(3, 2.0 + i * 0.25), 0.4)}>
          <rect class="bd__tick" x={TX + 90} y={y - 10} width="20" height="20" /><path class="bd__tickmark" d={`M${TX + 95} ${y}l3.5 4 6.5-8`} />
        </g>
      ))}
    </g>

    <!-- frame 5: a lawyer runs the case, more victims join -->
    <g class="bd__frame bd__frame--last" style={frameStyle(4)}>
      <HeroFigure kind="lawyer" x={lawyer5[0]} y={lawyer5[1]} delay={t(4)} dur={0.5} />
      <HeroTag text="lawyer or firm" x={lawyer5[0]} y={lawyer5[1] + 118} delay={t(4, 0.4)} anchor="mid" />
      <HeroFigure kind="judge" x={judge[0]} y={judge[1]} delay={t(4, 0.3)} dur={0.5} />
      <g class="bd__fade" style={sty(t(4, 0.4), 0.4)}>
        <rect class="bd__box" x={bench.x} y={bench.y} width={bench.w} height={bench.h} />
        <path class="bd__gavel" d={`M${bench.x + 14} ${bench.y + 8}L${bench.x + 40} ${bench.y - 18}`} />
        <rect class="bd__gavel-head" x={bench.x + 34} y={bench.y - 34} width="30" height="14" transform={`rotate(-45 ${bench.x + 49} ${bench.y - 27})`} />
      </g>
      <HeroTag text="court" x={judge[0]} y={bench.y + bench.h + 40} delay={t(4, 0.6)} anchor="mid" />
      <g class="bd__target" style={sty(t(4, 1.0), 0.4)}>
        <rect class="bd__stamp" x={bench.x + 20} y={bench.y + 18} width="130" height="40" />
        <text class="bd__stamp-text" x={bench.x + 85} y={bench.y + 45}>case won</text>
      </g>
      {crowd.map((v, i) => <HeroFigure kind="victim" x={v[0]} y={v[1]} delay={t(4, 2.1 + i * 0.12)} dur={0.4} arms="up" scale={0.7} />)}
      <HeroTag text="victims gathered by Celia" x={crowd[3][0]} y={crowd[3][1] + 120} delay={t(4, 3.0)} anchor="mid" />

      <!-- after the win the lawyer chooses: pay the wallets Celia lists, or contact the victims directly -->
      <path class="bd__edge bd__edge--thin" style={sty(t(4, 3.7), 0.5)} d={d([[lawyer5[0] - 15, 530 - UP], [crowd[1][0] + 10, 662 - UP]])} pathLength="1" />
      <path class="bd__edge bd__edge--thin" style={sty(t(4, 3.7), 0.5)} d={d([[lawyer5[0] + 15, 530 - UP], [crowd[5][0] - 10, 662 - UP]])} pathLength="1" />
      {[0, 1].map((k) => <g class="bd__packet bd__coin" style={ride(t(4, 4.2 + k * 0.7), 0.9, [[lawyer5[0] - 15, 530 - UP], [crowd[1][0] + 10, 662 - UP]])}><circle r="14" /><text y="5">$</text></g>)}
