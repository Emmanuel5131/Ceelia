---
import SectionHeader from './ui/SectionHeader.astro';
import { collective } from '../data/home';
---
<section id="collective" class="section container" aria-labelledby="collective-title">
  <SectionHeader id="collective-title" align="split" leadBelow title={collective.title} lead={collective.lead} />

  <ul class="principles" role="list">
    {collective.principles.map((p) => (
      <li class="principle">
        <h3 class="principle__title">{p.title}</h3>
        <p class="principle__text">{p.text}</p>
      </li>
    ))}
  </ul>

  <h3 class="roles__title">{collective.rolesTitle}</h3>
  <ol class="roles" role="list">
    {collective.roles.map((r, i) => (
      <li class="role">
        <p class="role__n">0{i + 1}</p>
        <h4 class="role__name">{r.role}</h4>
        <p class="role__does">{r.does}</p>
        <p class="role__record"><span>Onchain record</span>{r.record}</p>
      </li>
    ))}
  </ol>
</section>
<style>
  .principles { margin-top: 56px; display: grid; border-top: 1px solid var(--line); }
  .principle { padding: 28px 0; border-bottom: 1px solid var(--line); display: grid; gap: 8px; align-content: start; }
  .principle__title { font-size: var(--fs-h3); line-height: var(--lh-tight); letter-spacing: var(--track-l); }
  .principle__text { font-size: .95rem; line-height: 1.55; color: var(--brand-ink); max-width: 34ch; }
  @media (min-width: 900px) {
    .principles { grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); }
    .principle { padding: 32px 32px 36px; border-bottom: 0; border-left: 1px solid var(--line); }
    .principle:first-child { padding-left: 0; border-left: 0; }
  }

  .roles__title { margin-top: 96px; font-family: var(--font-mono); font-size: var(--fs-small); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--brand-ink); }
  .roles { margin-top: 24px; display: grid; gap: 16px; }
  .role { background: var(--cream); padding: 32px; display: grid; gap: 12px; align-content: start; }
  .role__n { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--brand-ink); }
  .role__name { font-size: var(--fs-h3); line-height: var(--lh-tight); letter-spacing: var(--track-l); }
  .role__does { font-size: .95rem; line-height: 1.55; color: var(--brand-ink); }
  .role__record { margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--line); font-size: .9rem; font-weight: 500; }
  .role__record span { display: block; font-family: var(--font-mono); font-size: var(--fs-xs); font-weight: 400; color: var(--brand-ink); margin-bottom: 4px; }
  @media (min-width: 760px) { .roles { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .roles { grid-template-columns: repeat(4, 1fr); } }
</style>
