---
import Button from './ui/Button.astro';
import Lines from './ui/Lines.astro';
const { title = 'Lost money to a\ncrypto scheme?', lead = 'Add your case. If you’re a lawyer or run a law firm, join the case bank and take it forward.' } = Astro.props as { title?: string; lead?: string };
---
<section id="report" class="section container cta" aria-labelledby="cta-title">
  <h2 id="cta-title" class="h2" data-split><Lines text={title} /></h2>
  <p class="lead" data-reveal data-delay=".15">{lead}</p>
  <div class="cta__btns" data-stagger><Button href="mailto:hello@example.com?subject=Report%20fraud" variant="solid">Report fraud</Button><Button href="mailto:hello@example.com?subject=Join%20as%20a%20lawyer%20or%20firm">Join as a lawyer or firm</Button></div>
</section>
<style>
  .cta { display: grid; justify-items: center; text-align: center; gap: 24px; }
  .cta .lead { max-width: 35rem; }
  .cta__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
</style>
