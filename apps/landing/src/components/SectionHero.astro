---
import Lines from './ui/Lines.astro';
import Button from './ui/Button.astro';
import HeroBackdrop from './HeroBackdropStick.astro';
import { hero } from '../data/home';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"><HeroBackdrop /></div>
  <div class="hero__inner container">
    <div class="hero__copy">
      <h1 id="hero-title" class="h1" data-split="load"><Lines text={hero.title} /></h1>
      <p class="lead" data-reveal="load" data-delay=".45">{hero.lead}</p>
      <div class="hero__ctas" data-stagger="load" data-delay=".6">
        <Button href={hero.primary.href} variant="solid">{hero.primary.label}</Button>
        <Button href={hero.secondary.href}>{hero.secondary.label}</Button>
      </div>
    </div>
  </div>
</section>
<style>
  /* full-height hero: copy on the left, the animated trail behind it on the right */
  .hero { position: relative; min-height: clamp(560px, calc(100svh - 76px), 860px); display: grid; align-items: center; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  /* the copy is indented from the logo and sits a little below the middle, with room above it, like a landing hero rather than a page header */
  .hero__inner { position: relative; z-index: 1; padding-block: clamp(56px, 9svh, 120px) clamp(56px, 8svh, 104px); padding-inline: max(24px, 2.5vw); }
  .hero__copy { display: grid; gap: 32px; max-width: 44rem; justify-items: start; }
  /* Aeonik ships 300, 400 and 700 only, so a thin stroke gives the title a weight between regular and bold */
  .hero h1 { line-height: var(--lh-tight); letter-spacing: var(--track-xl); word-spacing: var(--words-xl); -webkit-text-stroke: .02em currentColor; }
  .hero .lead { max-width: 37.5rem; font-size: clamp(1.0625rem, 1.4vw, 1.1875rem); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 16px; }
  .hero__ctas :global(.btn) { min-width: 200px; }
  @media (max-width: 899.98px) { .hero__ctas :global(.btn) { min-width: 0; flex: 1 1 180px; } }
</style>
