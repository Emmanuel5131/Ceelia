---
import type { HTMLAttributes } from 'astro/types';
type Variant = 'outline' | 'solid' | 'light' | 'outline-light';
type Props = { href?: string; variant?: Variant; size?: 'md' | 'lg'; full?: boolean; external?: boolean; class?: string; download?: boolean | string } & Omit<HTMLAttributes<'button'>, 'class'>;
const { href, variant = 'outline', size = 'md', full = false, external = false, class: cls, ...rest } = Astro.props as Props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, full && 'btn--full', cls];
---
{href ? (
  <a href={href} class:list={classes} {...(rest as Record<string, unknown>)} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><span class="btn__label"><slot /></span></a>
) : (
  <button class:list={classes} type="button" {...rest}><span class="btn__label"><slot /></span></button>
)}
<style>
  .btn { position: relative; isolation: isolate; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 12px; font-family: var(--font-body); font-weight: 700; font-size: var(--fs-body); line-height: 1.2; min-height: 52px; padding: 8px 32px; border: 1.5px solid transparent; border-radius: 999px; transition: color .45s cubic-bezier(.16,1,.3,1), border-color .3s; white-space: nowrap; }
  /* the button never moves: the fill blooms as a circle from where the pointer enters (--fx/--fy, set in motion.ts)
     and retracts toward where it leaves; the label lifts a hair and settles, and a press gives a soft 1px give */
  .btn::before { content: ''; position: absolute; inset: -1px; z-index: -1; background: var(--sweep, var(--brand)); clip-path: circle(0% at var(--fx, 50%) var(--fy, 100%)); transition: clip-path .7s cubic-bezier(.16,1,.3,1); }
  .btn:hover::before, .btn:focus-visible::before { clip-path: circle(150% at var(--fx, 50%) var(--fy, 100%)); }
  .btn__label { display: inline-flex; align-items: center; gap: 8px; transition: transform .5s cubic-bezier(.16,1,.3,1); }
  .btn:hover .btn__label { transform: translateY(-1px); }
  .btn:active .btn__label { transform: translateY(0) scale(.98); transition-duration: .15s; }
  @media (prefers-reduced-motion: reduce) { .btn::before { transition: opacity .3s; clip-path: none; opacity: 0; } .btn:hover::before, .btn:focus-visible::before { clip-path: none; opacity: 1; } }
  .btn--lg { min-height: 60px; padding: 8px 40px; font-size: 1.0625rem; }
  .btn--full { width: 100%; }
  .btn--outline { border-color: var(--brand); color: var(--brand); background: var(--white); }
  .btn--outline:hover { border-color: var(--brand); color: var(--white); }
  .btn--solid { background: var(--brand); color: var(--white); border-color: var(--brand); }
  .btn--solid { --sweep: #1B2A44; }
  .btn--light { background: var(--white); color: var(--brand); border-color: var(--white); }
  .btn--light { --sweep: var(--cream-2); }
  .btn--outline-light { color: var(--white); border-color: rgb(255 255 255 / .9); }
  .btn--outline-light { --sweep: var(--white); }
  .btn--outline-light:hover { color: var(--brand); }
</style>
