---
/**
 * Section heading block. "split" = title left / lead right (desktop), "center" = centred,
 * "left" = stacked. Optional actions slot (e.g. a "See All" button).
 */
import Lines from './Lines.astro';
export interface Props { eyebrow?: string; title: string; lead?: string; align?: 'split' | 'center' | 'left'; id?: string; level?: 'h1' | 'h2'; onBrand?: boolean; leadBelow?: boolean; intro?: boolean }
const { eyebrow, title, lead, align = 'split', id, level = 'h2', onBrand = false, leadBelow = false, intro = false } = Astro.props;
const m = intro ? 'load' : '';
const leadInMain = align !== 'split' || leadBelow;
const Heading = level;
const hasActions = Astro.slots.has('default');
---
<header class:list={['sh', `sh--${align}`, onBrand && 'on-brand']}>
  <div class="sh__main">
    {eyebrow && <p class="eyebrow" data-scramble={m}>{eyebrow}</p>}
    <Heading id={id} class="h2 sh__title" data-split={m}><Lines text={title} /></Heading>
    {leadInMain && lead && <p class="lead sh__lead" data-reveal={m} data-delay=".15">{lead}</p>}
  </div>
  {align === 'split' && ((lead && !leadInMain) || hasActions) && (
    <div class="sh__aside" data-reveal={m} data-delay=".2">
      {lead && !leadInMain && <p class="lead sh__lead">{lead}</p>}
      <slot />
    </div>
  )}
  {align !== 'split' && hasActions && <div class="sh__actions" data-reveal={m} data-delay=".25"><slot /></div>}
</header>
<style>
  .sh { display: grid; gap: 24px; }
  .sh__main { display: grid; gap: 16px; }
  .sh--split { grid-template-columns: 1fr; align-items: end; }
  .sh__aside { display: grid; gap: 24px; justify-items: start; }
  .sh__aside .sh__lead { max-width: 30rem; }
  .sh--center { text-align: center; justify-items: center; }
  .sh--center .sh__main { justify-items: center; gap: 16px; }
  .sh--center .sh__lead { max-width: 45rem; }
  .sh--split .sh__main .sh__lead { max-width: 39rem; margin-top: 8px; }
  .sh__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .sh--center .sh__actions { justify-content: center; }
  @media (min-width: 900px) {
    .sh--split { grid-template-columns: 1fr auto; gap: 40px; }
    .sh__aside { justify-items: end; }
    .sh__aside:has(.sh__lead) { justify-items: start; }
  }
</style>
