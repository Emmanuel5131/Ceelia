PORT=6790

# This endpoint's public URL, as an assistant reaches it.
MCP_PUBLIC_URL=http://localhost:6790/mcp

# The Clerk Frontend API URL of this app: the OAuth server an assistant signs in with. In the Clerk dashboard, turn on
# OAuth applications and dynamic client registration. See docs/ops/mcp.md.
AUTH_SERVER_URL=https://your-instance.clerk.accounts.dev

# The Celia web app. The MCP server asks it who is calling and for the cases, passing on the assistant's token.
WEB_URL=http://localhost:3000
