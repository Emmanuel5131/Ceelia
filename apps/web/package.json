{
  "name": "@celia/web",
  "private": true,
  "author": "Ixartz (https://github.com/ixartz)",
  "type": "module",
  "scripts": {
    "dev:spotlight": "pnpm dlx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "build:next": "next build",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate build:next",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db-server:file": "pglite-server -m 100 --db=local.db --run 'pnpm run db:migrate'",
    "db-server:memory": "pglite-server -m 100 --run 'pnpm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@arcjet/next": "1.14.1",
    "@celia/core": "workspace:*",
    "@celia/jurisdictions": "workspace:*",
    "@clerk/localizations": "4.24.1",
    "@clerk/nextjs": "7.9.20",
    "@clerk/shared": "4.41.1",
    "@hookform/resolvers": "5.9.2",
    "@logtape/logtape": "2.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "10.76.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "^9.3.1",
    "@web3icons/react": "^4.1.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.20",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "translation-resilience": "0.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "0.15.0",
    "@electric-sql/pglite-socket": "0.2.14",
    "@faker-js/faker": "10.6.0",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.64.1",
    "@spotlightjs/spotlight": "4.12.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.9",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.42.1",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
