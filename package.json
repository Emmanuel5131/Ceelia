{
  "name": "celia",
  "private": true,
  "type": "module",
  "description": "Celia: an onchain case bank for crypto fraud. apps/web is the product, apps/landing is the marketing site.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @celia/web run dev",
    "dev:landing": "pnpm --filter @celia/landing run dev",
    "build": "pnpm --filter @celia/web run build",
    "build-local": "pnpm --filter @celia/web run build-local",
    "build:landing": "pnpm --filter @celia/landing run build",
    "start": "pnpm --filter @celia/web run start",
    "lint": "pnpm --filter @celia/web run lint",
    "lint:fix": "pnpm --filter @celia/web run lint:fix",
    "check:types": "pnpm --filter @celia/web run check:types",
    "check:deps": "pnpm --filter @celia/web run check:deps",
    "check:i18n": "pnpm --filter @celia/web run check:i18n",
    "test": "pnpm --filter @celia/web run test",
    "test:e2e": "pnpm --filter @celia/web run test:e2e",
    "storybook:test": "pnpm --filter @celia/web run storybook:test",
    "commit": "commit"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/prompt-cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.31"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
